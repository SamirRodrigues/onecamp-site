# N?o servir arquivos de projeto ao p?blico
<FilesMatch "^(README\.md|\.gitignore|modelo-planilha-equipes\.csv)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^apps-script/ - [F,L]
</IfModule>


# Scripts e dados sempre revalidados (evita versao antiga em cache)
<IfModule mod_headers.c>
<FilesMatch "\.(js|json)$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
</IfModule>

